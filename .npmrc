# npm tries to resolve better-auth's OPTIONAL @sveltejs/kit peer, which pulls a
# vite 8 that conflicts with the vite 7 vitest uses. Nothing svelte is
# installed or wanted; npm is validating a peer for a framework this project
# does not use.
#
# Without this, `npm ci` fails outright with ERESOLVE, which means CI cannot
# install dependencies and no image can be built. That is exactly what
# happened: the runs after the better-auth 1.7 upgrade could not start.
#
# This is npm's pre-7 behaviour, and it applies to every invocation in the
# project rather than living in one CI flag that the next person runs without.
legacy-peer-deps=true

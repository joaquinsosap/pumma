# Data source: memory (demo) | mongodb (Atlas)
# Tip: use DATA_SOURCE=memory in .env.development.local for fast local dev.
# .env.local overrides .env.development, so Atlas settings there always win.
DATA_SOURCE=memory

# Dev auto-reload (optional; also set in .env.development)
# WATCHPACK_POLLING=true
# CHOKIDAR_USEPOLLING=true

# MongoDB Atlas (phase 2)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB=puma

# AI planner (/assistant). Each user picks a provider and pastes their own key
# in Settings → Assistant; these set the default for a whole self-hosted
# instance, and only apply in memory mode (hosted accounts must bring a key).
#
# One of: anthropic | openai | google | openrouter | groq | deepseek |
#         mistral | xai | ollama
# AI_PROVIDER=anthropic
# AI_API_KEY=                     # any provider; the vendor names below still work
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model override (defaults to the provider's own default)
# ASSISTANT_MODEL=claude-haiku-4-5
# Where a local Ollama listens — operator-set, never user-set
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Auth (Better Auth) — required when DATA_SOURCE=mongodb
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Public base URL in production (defaults to http://localhost:3000)
# BETTER_AUTH_URL=https://puma.example.com

# ── Content encryption — required when DATA_SOURCE=mongodb ──────────────────
# Wraps a per-user data key; task titles, notes, habit names and the rest are
# encrypted with that key before they reach the database.
#
# Generate with: openssl rand -base64 32
#
# ⚠ BACK THIS UP SOMEWHERE OTHER THAN THE SERVER, BEFORE FIRST USE.
#   Lose it and every user's content is unrecoverable — there is no reset and
#   no support path. It is deliberately not BETTER_AUTH_SECRET: the two
#   protect different things and should be rotatable independently.
DATA_ENCRYPTION_KEY=
# `env` (default) reads the key above. `kms` is reserved for an AWS KMS master
# key, which additionally makes every use of it an audit-log entry.
# DATA_ENCRYPTION_PROVIDER=env

# ── Hosted mode (optional — self-hosted installs leave all of this unset) ───
# When BILLING_ENABLED=1 the app gates sign-ins on a `subscriptions` row
# (written by your own external billing service) or the OWNER_EMAILS allowlist.
# BILLING_ENABLED=1
# OWNER_EMAILS=you@example.com
# Where anonymous visitors at "/" are sent (e.g. a marketing page another
# service renders behind the same reverse proxy). Unset → straight to /login.
# MARKETING_HOME=/landing

# ── Reminders (optional) ────────────────────────────────────────────────────
# Without these, reminders still work: they appear in the app's own bell, and
# as OS notifications while a PUMMA tab is open (permission is all that needs).
# These add the last tier only — delivery when PUMMA is closed entirely, which
# on iPhone also requires the app be added to the Home Screen.
#
# Generate the pair with: npx web-push generate-vapid-keys
#
# ⚠ BACK THE PAIR UP. Rotating it silently unsubscribes every device that ever
#   turned notifications on, with no error and no way to tell who was lost.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# A contact address, per RFC 8292, so a push service has somebody to reach.
# VAPID_SUBJECT=https://your-domain.example

# ---------------------------------------------------------------------------
# MCP (letting an AI client work with this account's data)
#
# The endpoint is off per account until the user turns it on in Settings, so
# nothing here opens anything by itself. It needs DATA_SOURCE=mongodb, and
# BETTER_AUTH_URL must be the real public URL: it is what tokens are bound to
# as their audience, and a wrong value refuses every token rather than failing
# loudly.
#
# Set to 0 to switch the endpoint off for this whole instance, whatever any
# account has chosen. Default is on.
# MCP_ENABLED=0
# Requests per minute, per user, per connected client. Default 120.
# MCP_RATE_LIMIT_PER_MINUTE=120
